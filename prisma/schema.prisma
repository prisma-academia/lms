generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ClientStatus {
  ACTIVE
  SUSPENDED
}

enum RoleScope {
  PLATFORM
  TENANT
}

enum ActorType {
  PLATFORM_USER
  TENANT_USER
  CLIENT
  SYSTEM
  /// A tenant Developer API key (lib/api/v1). actorId is the ApiKey id.
  API_KEY
}

enum SessionUserType {
  PLATFORM
  TENANT
  CLIENT
}

enum SessionScope {
  FULL
  MUST_CHANGE_PASSWORD
}

enum OtpPurpose {
  CLIENT_LOGIN
  CLIENT_SIGNUP
  TENANT_REGISTRATION
  TENANT_OWNER_CHANGE_EMAIL
}

enum TenantPlan {
  TRIAL
  ACTIVE
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum PaymentProvider {
  PAYSTACK
  FLUTTERWAVE
  MANUAL
  /// The active gateway. PAYSTACK and FLUTTERWAVE remain for historical rows.
  MONNIFY
}

/// What a site-builder page is for. PAGE is an ordinary CMS page; the others
/// replace a built-in screen when a valid page of that kind is published.
enum SitePageKind {
  PAGE
  LOGIN
  REGISTER
  FORGOT_PASSWORD
  COURSES
  COURSE_DETAIL
  PROGRAMME_DETAIL
}

enum ReferralEventType {
  SIGNUP
  ENROLLMENT
  PURCHASE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum SubaccountStatus {
  PENDING
  ACTIVE
  FAILED
  SUSPENDED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Access visibility for courses and programmes.
/// PUBLIC: appears in the client catalog and is self-enrollable.
/// PRIVATE: hidden from catalog; learners must be manually onboarded by staff.
enum ContentVisibility {
  PUBLIC
  PRIVATE
}

enum LessonContentType {
  TEXT
  HTML
  VIDEO_URL
  FILE
  QUIZ
  /// contentJson: { examId }. Opens the exam's own locked window.
  EXAM
}

enum SitePageStatus {
  DRAFT
  PUBLISHED
}

enum AssignmentType {
  TEXT
  FILE
  LINK
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
  RETURNED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  /// Free-text, graded by AI against the author's rubric (see Question.rubricJson).
  ESSAY
  /// Cloze: several blanks inside the prompt, each typed or picked.
  FILL_BLANKS
  /// A number, accepted within a tolerance.
  NUMERIC
  /// Pair each left item with a right item.
  MATCHING
  /// Put the items in the right order.
  ORDERING
  /// Drag each item into the right group.
  CATEGORIZE
  /// Click the right region of an image.
  HOTSPOT
  /// Rows x columns of choices (Likert, true/false per statement).
  MATRIX
  /// A typed maths expression, checked against accepted forms or numerically.
  EQUATION
  /// Exams only, marked by staff: an uploaded file (worked solution).
  FILE_UPLOAD
  /// Exams only, marked by staff: a recorded spoken answer.
  AUDIO_RESPONSE
  /// Exams only, marked by staff (keyword hints optional). Code is never run.
  CODE
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ExamStatus {
  DRAFT
  /// Published; candidates can see it and sit it inside its window.
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum ExamKind {
  /// Sat by learners enrolled on a course (optionally as a course lesson).
  COURSE
  /// A test on its own: entrance exams, mocks, certification.
  STANDALONE
}

enum ExamNavigation {
  FREE
  /// Forward only: an answered question cannot be revisited.
  LINEAR
  /// Free inside a section; a finished section cannot be reopened.
  SECTION_LOCKED
}

enum ExamResultRelease {
  IMMEDIATE
  AFTER_CLOSE
  MANUAL
}

enum ExamReviewMode {
  NONE
  SCORE_ONLY
  ANSWERS
  ANSWERS_WITH_EXPLANATIONS
}

enum ExamCalculator {
  NONE
  BASIC
  SCIENTIFIC
}

/// How a learner who is not yet on the candidate list can join.
enum ExamAccessMode {
  /// Only candidates staff added.
  INVITED
  /// Any learner enrolled on the exam's course.
  ENROLLED
  /// Any learner of the academy who has the access code.
  ACCESS_CODE
}

enum ExamCandidateStatus {
  ACTIVE
  BLOCKED
  WITHDRAWN
}

enum ExamAttemptStatus {
  IN_PROGRESS
  /// Paused by an invigilator; the clock is stopped.
  PAUSED
  /// Frozen after too many integrity violations until an invigilator unlocks it.
  LOCKED
  SUBMITTED
  /// Ended by the invigilator without the candidate's submit.
  TERMINATED
}

enum ExamSubmitReason {
  MANUAL
  TIME_UP
  MAX_VIOLATIONS
  PROCTOR
  WINDOW_CLOSED
}

/// Whether an attempt's score is final. Only GRADED attempts can unlock a lesson.
enum GradingStatus {
  GRADED
  /// An essay grader call failed; the learner's answers are saved and re-gradable.
  PENDING
  FAILED
}

enum EventType {
  LIVE_SESSION
  DEADLINE
  REMINDER
  ANNOUNCEMENT
}

enum EventAudience {
  ALL
  CLIENT
  GROUP
}

enum EventRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum NotificationCategory {
  MESSAGE
  ANNOUNCEMENT
  REMINDER
}

/// Broad rendering class for a library item, derived from its content type at
/// upload time. Drives which player the learner gets.
enum MediaKind {
  VIDEO
  AUDIO
  PDF
  IMAGE
  DOC
  ARCHIVE
  OTHER
}

enum UploadSessionStatus {
  PENDING
  COMPLETED
  ABORTED
  EXPIRED
}

/// Who a library grant is issued to.
enum GrantSubjectType {
  ALL_CLIENTS
  CLIENT
  CLIENT_GROUP
  COURSE
  PROGRAMME
}

enum EntitlementSource {
  PURCHASE
  MANUAL
}

model Tenant {
  id                   String             @id @default(cuid())
  slug                 String             @unique
  name                 String
  status               TenantStatus       @default(ACTIVE)
  plan                 TenantPlan         @default(TRIAL)
  trialEndsAt          DateTime?
  storageUsedBytes     BigInt             @default(0)
  storageQuotaBytes    BigInt             @default(10737418240)
  /// Bytes committed to in-flight multipart uploads. Counted against the quota
  /// alongside storageUsedBytes so concurrent uploads cannot overshoot it.
  /// The reconcile job is the source of truth for this value, not the deltas.
  storageReservedBytes BigInt             @default(0)
  subscriptionStatus   SubscriptionStatus @default(NONE)
  subscriptionPlanId   String?
  subscriptionPlan     SubscriptionPlan?  @relation(fields: [subscriptionPlanId], references: [id], onDelete: SetNull)
  subscriptionEndsAt   DateTime?
  billingProvider      PaymentProvider?
  billingCustomerRef   String?
  ownerUserId          String?
  companyEmail         String?
  companyPhone         String?
  website              String?
  addressLine1         String?
  addressLine2         String?
  city                 String?
  region               String?
  postalCode           String?
  country              String?
  settingsJson         Json               @default("{}")
  createdAt            DateTime           @default(now())
  archivedAt           DateTime?

  users                      TenantUser[]
  clients                    Client[]
  userGroups                 UserGroup[]
  clientGroups               ClientGroup[]
  pendingClientRegistrations PendingClientRegistration[]
  roleTemplates              RoleTemplate[]
  templates                  Template[]
  activityLogs               ActivityLog[]
  subaccount                 TenantSubaccount?
  courses                    Course[]
  programmes                 Programme[]
  platformPayments           PlatformPayment[]
  coursePayments             CoursePayment[]
  programmePayments          ProgrammePayment[]
  assignments                Assignment[]
  submissions                Submission[]
  grades                     Grade[]
  fees                       Fee[]
  questionBanks              QuestionBank[]
  questionTags               QuestionTag[]
  quizzes                    Quiz[]
  certificates               Certificate[]
  events                     Event[]
  messages                   Message[]
  libraryItems               LibraryItem[]
  libraryFolders             LibraryFolder[]
  libraryTags                LibraryTag[]
  libraryUploads             LibraryUpload[]
  libraryGrants              LibraryGrant[]
  libraryEntitlements        LibraryEntitlement[]
  libraryPayments            LibraryPayment[]
  programmeEnrollments       ProgrammeEnrollment[]
  sitePages                  SitePage[]
  siteLayout                 SiteLayout?
  referralCodes              ReferralCode[]
  referralEvents             ReferralEvent[]
  exams                      Exam[]
  apiKeys                    ApiKey[]
  webhookEndpoints           WebhookEndpoint[]
  webhookEvents              WebhookEvent[]
  integrations               TenantIntegration[]
  calendarFeedTokens         CalendarFeedToken[]

  @@index([status])
  @@index([plan, trialEndsAt])
  @@index([subscriptionStatus])
}

model SubscriptionPlan {
  id                String   @id @default(cuid())
  code              String   @unique
  name              String
  priceMonthlyCents Int
  currency          String   @default("NGN")
  storageQuotaBytes BigInt
  maxLearners       Int?
  maxInstructors    Int?
  maxCourses        Int?
  isPublic          Boolean  @default(true)
  sortOrder         Int      @default(0)
  tenants           Tenant[]
}

model TenantSubaccount {
  tenantId                 String           @id
  tenant                   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessName             String
  businessEmail            String?
  businessPhone            String?
  settlementBankCode       String
  settlementAccountNumber  String
  settlementAccountName    String?
  paystackSubaccountCode   String?
  paystackStatus           SubaccountStatus @default(PENDING)
  paystackProvisionedAt    DateTime?
  flutterwaveSubaccountId  String?
  flutterwaveStatus        SubaccountStatus @default(PENDING)
  flutterwaveProvisionedAt DateTime?
  /// Monnify sub-account that receives this academy's share of each sale.
  monnifySubaccountCode    String?
  monnifyStatus            SubaccountStatus @default(PENDING)
  monnifyProvisionedAt     DateTime?
  courseSalesEnabled       Boolean          @default(false)
  platformCommissionPct    Int              @default(10)
  defaultProvider          PaymentProvider?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
}

model PlatformPayment {
  id           String          @id @default(cuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId       String
  provider     PaymentProvider
  amountCents  Int
  currency     String
  status       PaymentStatus   @default(PENDING)
  externalRef  String          @unique
  providerData Json?
  createdAt    DateTime        @default(now())
  completedAt  DateTime?

  @@index([tenantId, createdAt])
}

/// A Client pays a Tenant for a whole Programme (course bundle); supports split
/// payout. On success every published course in the programme is enrolled.
model ProgrammePayment {
  id                String          @id @default(cuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programmeId       String
  programme         Programme       @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  clientId          String
  client            Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  provider          PaymentProvider
  amountCents       Int
  currency          String
  status            PaymentStatus   @default(PENDING)
  externalRef       String          @unique
  platformFeeCents  Int?
  tenantPayoutCents Int?
  providerData      Json?
  createdAt         DateTime        @default(now())
  completedAt       DateTime?

  enrollment ProgrammeEnrollment?

  @@index([tenantId, createdAt])
  @@index([programmeId])
  @@index([clientId])
}

model Course {
  id            String            @id @default(cuid())
  tenantId      String
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title         String
  slug          String
  description   String?
  status        CourseStatus      @default(DRAFT)
  visibility    ContentVisibility @default(PUBLIC)
  priceCents    Int?
  currency      String            @default("NGN")
  thumbnailKey  String?
  instructorId  String?
  /// The id an outside system (school portal, HR / CRM) knows this course by.
  externalId    String?
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  lessons       Lesson[]
  lessonGroups  LessonGroup[]
  enrollments   Enrollment[]
  payments      CoursePayment[]
  libraryGrants LibraryGrant[]
  assignments   Assignment[]
  programmes    ProgrammeCourse[]
  certificates  Certificate[]
  exams         Exam[]

  @@unique([tenantId, slug])
  @@unique([tenantId, externalId])
  @@index([tenantId, status])
}

model Lesson {
  id               String            @id @default(cuid())
  courseId         String
  course           Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tenantId         String
  groupId          String?
  group            LessonGroup?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  title            String
  sortOrder        Int               @default(0)
  contentType      LessonContentType @default(TEXT)
  contentJson      Json              @default("{}")
  assetKey         String?
  /// FK to library item for FILE lessons (preferred over assetKey alone).
  libraryItemId    String?
  libraryItem      LibraryItem?      @relation(fields: [libraryItemId], references: [id], onDelete: SetNull)
  durationMin      Int?
  /// When false, the completion gate skips the dwell timer for this lesson — the
  /// learner may mark it complete as soon as the content-consumed signal (scroll
  /// / playback / quiz) is satisfied. Defaults true so lessons authored before
  /// the toggle existed keep the timer they were written under.
  requireDwell     Boolean           @default(true)
  createdAt        DateTime          @default(now())
  progress         LessonProgress[]
  /// Quiz questions that were drawn from this lesson (their "read up" target).
  sourcedQuestions Question[]        @relation("QuestionSource")

  @@index([courseId, sortOrder])
  @@index([tenantId])
  @@index([groupId])
  @@index([libraryItemId])
}

/// A group/subgroup within a course to organize lessons beyond flat sortOrder.
/// Self-referencing via parentId for subgroups.
model LessonGroup {
  id        String        @id @default(cuid())
  tenantId  String
  courseId  String
  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    LessonGroup?  @relation("LessonGroupTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  LessonGroup[] @relation("LessonGroupTree")
  title     String
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  lessons   Lesson[]

  @@index([tenantId])
  @@index([courseId, sortOrder])
  @@index([parentId])
}

/// A programme groups multiple courses into a curriculum. Courses can be
/// standalone or belong to one or more programmes (via ProgrammeCourse).
model Programme {
  id            String                @id @default(cuid())
  tenantId      String
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title         String
  slug          String
  description   String?
  status        CourseStatus          @default(DRAFT)
  visibility    ContentVisibility     @default(PUBLIC)
  priceCents    Int?
  currency      String                @default("NGN")
  thumbnailKey  String?
  publishedAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  courses       ProgrammeCourse[]
  certificates  Certificate[]
  payments      ProgrammePayment[]
  enrollments   ProgrammeEnrollment[]
  libraryGrants LibraryGrant[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
}

/// Join row: a Course within a Programme. Marks required/optional, ordering,
/// and an optional group/subgroup label for organizing courses in a programme.
model ProgrammeCourse {
  id          String    @id @default(cuid())
  tenantId    String
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  required    Boolean   @default(true)
  sortOrder   Int       @default(0)
  groupLabel  String?
  createdAt   DateTime  @default(now())

  @@unique([programmeId, courseId])
  @@index([tenantId])
  @@index([courseId])
}

model Enrollment {
  id              String           @id @default(cuid())
  tenantId        String
  courseId        String
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  enrolledAt      DateTime         @default(now())
  completedAt     DateTime?
  progressPercent Int              @default(0)
  paymentId       String?          @unique
  payment         CoursePayment?   @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  lessonProgress  LessonProgress[]

  @@unique([courseId, clientId])
  @@index([tenantId])
  @@index([clientId])
}

/// Programme-level membership.
///
/// Enrollment is per-course (`@@unique([courseId, clientId])`), so before this
/// model a learner's programme membership was unrepresentable — the programme
/// enroll endpoints fanned out to courses and forgot the programme. Library
/// items assigned to a Programme resolve their audience through this table.
model ProgrammeEnrollment {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programmeId String
  programme   Programme         @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  paymentId   String?           @unique
  payment     ProgrammePayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  enrolledAt  DateTime          @default(now())
  completedAt DateTime?

  @@unique([programmeId, clientId])
  @@index([tenantId])
  @@index([clientId])
}

/// A learner's relationship with one lesson. NOTE: row presence means "opened",
/// NOT "completed" — `completedAt != null` is completion. Every read that counts
/// progress MUST filter on `completedAt: { not: null }`, or merely opening
/// lessons drives Enrollment.progressPercent to 100 and issues certificates.
model LessonProgress {
  id           String     @id @default(cuid())
  tenantId     String
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  /// First open. The dwell clock the completion gate measures against.
  startedAt    DateTime?
  completedAt  DateTime?

  @@unique([enrollmentId, lessonId])
  @@index([tenantId])
  @@index([enrollmentId, completedAt])
}

model CoursePayment {
  id                String          @id @default(cuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courseId          String
  course            Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  clientId          String
  client            Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  provider          PaymentProvider
  amountCents       Int
  currency          String
  status            PaymentStatus   @default(PENDING)
  externalRef       String          @unique
  platformFeeCents  Int?
  tenantPayoutCents Int?
  providerData      Json?
  createdAt         DateTime        @default(now())
  completedAt       DateTime?
  enrollment        Enrollment?

  @@index([tenantId, createdAt])
}

model Assignment {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  type        AssignmentType @default(TEXT)
  maxPoints   Int            @default(100)
  dueAt       DateTime?
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  submissions Submission[]

  @@index([tenantId, courseId])
  @@index([tenantId, dueAt])
}

model Submission {
  id           String           @id @default(cuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  clientId     String
  client       Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status       SubmissionStatus @default(SUBMITTED)
  textBody     String?
  fileKey      String?
  linkUrl      String?
  submittedAt  DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  grade        Grade?

  @@unique([assignmentId, clientId])
  @@index([tenantId, assignmentId])
  @@index([tenantId, clientId])
}

model Grade {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submissionId String     @unique
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  courseId     String
  clientId     String
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  points       Int
  maxPoints    Int
  feedback     String?
  gradedById   String?
  gradedAt     DateTime   @default(now())

  @@index([tenantId, clientId])
  @@index([tenantId, courseId])
}

/// A fee a tenant charges its clients. Targets either a single client or a
/// whole client group (exactly one of clientId / clientGroupId is set).
model Fee {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  amountCents   Int
  currency      String       @default("NGN")
  dueAt         DateTime?
  clientId      String?
  client        Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientGroupId String?
  clientGroup   ClientGroup? @relation(fields: [clientGroupId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  payments      FeePayment[]

  @@index([tenantId])
  @@index([clientId])
  @@index([clientGroupId])
}

/// A payment recorded against a fee, per client. Lets staff track who has paid.
model FeePayment {
  id          String        @id @default(cuid())
  tenantId    String
  feeId       String
  fee         Fee           @relation(fields: [feeId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  amountCents Int
  currency    String        @default("NGN")
  status      PaymentStatus @default(SUCCESS)
  method      String?
  paidAt      DateTime?
  note        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([feeId, clientId])
  @@index([tenantId])
  @@index([feeId])
  @@index([clientId])
}

/// A collection of questions. Access can be scoped to specific user groups via
/// QuestionBankAccess; no rows = accessible to all staff with the quizzes perm.
model QuestionBank {
  id           String               @id @default(cuid())
  tenantId     String
  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  questions    Question[]
  accessGroups QuestionBankAccess[]
  groups       QuestionGroup[]

  @@index([tenantId])
}

/// A shared stimulus — a reading passage, case study or diagram — that several
/// questions in the same bank are asked about. Shown beside them in a split pane.
model QuestionGroup {
  id           String       @id @default(cuid())
  tenantId     String
  bankId       String
  bank         QuestionBank @relation(fields: [bankId], references: [id], onDelete: Cascade)
  title        String?
  /// Sanitised HTML; may contain $..$ maths.
  stimulusHtml String
  /// Optional media: { kind: "image"|"audio"|"video", url, maxPlays? }
  mediaJson    Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  questions    Question[]

  @@index([tenantId])
  @@index([bankId])
}

/// Restricts a question bank to a user group. Presence of any row = restricted.
model QuestionBankAccess {
  id          String       @id @default(cuid())
  tenantId    String
  bankId      String
  bank        QuestionBank @relation(fields: [bankId], references: [id], onDelete: Cascade)
  userGroupId String
  userGroup   UserGroup    @relation(fields: [userGroupId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())

  @@unique([bankId, userGroupId])
  @@index([tenantId])
}

model QuestionTag {
  id       String            @id @default(cuid())
  tenantId String
  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  links    QuestionTagLink[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Question {
  id             String              @id @default(cuid())
  tenantId       String
  bankId         String
  bank           QuestionBank        @relation(fields: [bankId], references: [id], onDelete: Cascade)
  type           QuestionType        @default(SINGLE_CHOICE)
  prompt         String
  optionsJson    Json                @default("[]")
  answerJson     Json                @default("[]")
  /// ESSAY only; NULL for every other type. Shape: lib/schemas/essay-grading.ts
  /// `essayRubricSchema` — weighted criteria, an optional model answer, word bounds.
  /// A separate column rather than overloading answerJson, whose "option indices
  /// or accepted strings" meaning the scorer, seeds and export path all rely on.
  rubricJson     Json?
  points         Int                 @default(1)
  /// A nudge shown on request while answering. Never the answer itself.
  hint           String?
  /// Where this question's answer is taught, so a learner who gets it wrong can
  /// be sent back to read it. Only honoured when the lesson is in the course
  /// the learner is taking the quiz through, and unlocked for them.
  sourceLessonId String?
  sourceLesson   Lesson?             @relation("QuestionSource", fields: [sourceLessonId], references: [id], onDelete: SetNull)
  /// The `id` of the heading inside that lesson. May go stale if the heading
  /// is removed; the reader then falls back to `sourceExcerpt`.
  sourceAnchor   String?
  /// A short phrase from the passage, used to find it when the anchor is gone.
  sourceExcerpt  String?
  difficulty     QuestionDifficulty?
  /// Shown to the candidate after results are released (if the exam allows).
  explanation    String?
  /// Points taken away for a wrong (not blank) answer in an exam with negative
  /// marking. NULL = use the exam's default fraction.
  negativePoints Float?
  /// Multi-part types award proportional credit instead of all-or-nothing.
  partialCredit  Boolean             @default(false)
  /// Optional stimulus on the question itself: { kind, url, maxPlays? }.
  mediaJson      Json?
  groupId        String?
  group          QuestionGroup?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  /// Optional per-question time limit inside an exam.
  timeLimitSec   Int?
  /// Normalised prompt hash, for duplicate detection inside a bank.
  promptHash     String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  tags           QuestionTagLink[]
  quizLinks      QuizQuestion[]
  examItems      ExamSectionItem[]

  @@index([tenantId])
  @@index([bankId])
  @@index([sourceLessonId])
  @@index([bankId, promptHash])
  @@index([groupId])
}

model QuestionTagLink {
  id         String      @id @default(cuid())
  tenantId   String
  questionId String
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tagId      String
  tag        QuestionTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([questionId, tagId])
  @@index([tenantId])
}

model Quiz {
  id              String         @id @default(cuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  /// Percent needed to pass. NULL means 100 — every answer correct — which is
  /// how every quiz behaved before pass marks were enforced.
  passingScore    Int?
  timeLimitMin    Int?
  /// Whether learners may reveal a question's hint while answering.
  hintsEnabled    Boolean        @default(true)
  /// Whether a failed attempt names the questions that were wrong and links
  /// each to the lesson passage it tests.
  showReviewLinks Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  questions       QuizQuestion[]
  attempts        QuizAttempt[]

  @@index([tenantId])
}

model QuizQuestion {
  id         String   @id @default(cuid())
  tenantId   String
  quizId     String
  quiz       Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)
  points     Int?

  @@unique([quizId, questionId])
  @@index([tenantId])
  @@index([quizId, sortOrder])
}

model QuizAttempt {
  id              String        @id @default(cuid())
  tenantId        String
  quizId          String
  quiz            Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  startedAt       DateTime      @default(now())
  submittedAt     DateTime?
  scorePercent    Int?
  passed          Boolean?
  /// The learner's submission, keyed by questionId. Immutable once written.
  answersJson     Json          @default("{}")
  /// Grader output keyed by questionId: earned points, per-criterion essay
  /// scores and feedback. Kept apart from answersJson so a re-grade can be
  /// rewritten without ever touching what the learner actually submitted.
  resultsJson     Json          @default("{}")
  gradingStatus   GradingStatus @default(GRADED)
  gradingError    String?
  gradedAt        DateTime?
  /// The quiz's pass mark at the moment this attempt was graded. Lets an
  /// attempt that passed keep counting if the author later raises the mark.
  /// NULL on attempts graded before pass marks were enforced.
  passMarkApplied Int?
  /// How many times AI grading has been tried for this attempt. Bounds retries
  /// before the attempt is marked FAILED and handed to staff.
  gradingAttempts Int           @default(0)
  /// Staff user who marked the essays by hand, when the AI grader could not.
  gradedByUserId  String?

  @@index([tenantId])
  @@index([quizId])
  @@index([clientId])
  /// Serves the quiz-completion gate: "has this learner ever passed here?"
  @@index([clientId, quizId])
  /// Serves the staff list of attempts waiting on a grade.
  @@index([quizId, gradingStatus])
}

// ─────────────────────────────────────────────────────────────────────────────
// CBT / exams. Quizzes stay the light in-lesson check; an Exam is the formal,
// timed, invigilated sitting with its own locked window. See lib/exams/.
// ─────────────────────────────────────────────────────────────────────────────

model Exam {
  id               String             @id @default(cuid())
  tenantId         String
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title            String
  /// Short human code, e.g. "MTH101-MOCK". Unique per academy when set.
  code             String?
  description      String?
  /// Sanitised HTML shown in the lobby before the candidate starts.
  instructionsHtml String?
  status           ExamStatus         @default(DRAFT)
  kind             ExamKind           @default(STANDALONE)
  courseId         String?
  course           Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  durationMin      Int                @default(60)
  opensAt          DateTime?
  closesAt         DateTime?
  /// Minutes after opensAt (or a sitting's start) a candidate may still begin.
  lateEntryMin     Int?
  attemptsAllowed  Int                @default(1)
  cooldownMin      Int?
  navigation       ExamNavigation     @default(FREE)
  shuffleQuestions Boolean            @default(true)
  shuffleOptions   Boolean            @default(true)
  /// Percent of the total needed to pass.
  passMark         Int                @default(50)
  /// Fraction of a question's points deducted for a wrong answer. NULL = off.
  negativeMarking  Float?
  /// [{ min: 70, label: "A", remark: "Excellent" }, ...] highest first.
  gradeBandsJson   Json               @default("[]")
  resultRelease    ExamResultRelease  @default(IMMEDIATE)
  reviewMode       ExamReviewMode     @default(SCORE_ONLY)
  calculator       ExamCalculator     @default(NONE)
  formulaSheetHtml String?
  /// Candidate tools: { scratchpad, highlighter, lineReader, tts, fontScale }.
  toolsJson        Json               @default("{}")
  /// Lockdown policy; shape in lib/exams/settings.ts (securitySchema).
  securityJson     Json               @default("{}")
  accessMode       ExamAccessMode     @default(INVITED)
  accessCode       String?
  /// Whether candidates may sign in with Exam ID + PIN instead of an account.
  pinLogin         Boolean            @default(true)
  /// Minutes past the deadline in which answers saved while offline still count.
  offlineGraceMin  Int                @default(3)
  /// Award this certificate template on a pass.
  certificateId    String?
  publishedAt      DateTime?
  createdById      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  sections         ExamSection[]
  sittings         ExamSitting[]
  candidates       ExamCandidate[]
  attempts         ExamAttempt[]
  announcements    ExamAnnouncement[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([courseId])
  @@index([status, closesAt])
}

model ExamSection {
  id           String            @id @default(cuid())
  tenantId     String
  examId       String
  exam         Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  title        String
  instructions String?
  sortOrder    Int               @default(0)
  /// Optional own timer; when it runs out the section locks.
  timeLimitMin Int?
  /// Random draw rules: [{ id, bankId, tagIds[], difficulty?, types[], count, points? }]
  poolsJson    Json              @default("[]")
  shuffle      Boolean           @default(true)
  items        ExamSectionItem[]

  @@index([tenantId])
  @@index([examId, sortOrder])
}

model ExamSectionItem {
  id         String      @id @default(cuid())
  tenantId   String
  sectionId  String
  section    ExamSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  questionId String
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sortOrder  Int         @default(0)
  points     Int?

  @@unique([sectionId, questionId])
  @@index([tenantId])
  @@index([questionId])
}

/// A batch / session of an exam: a time slot, a venue, an IP range.
model ExamSitting {
  id          String          @id @default(cuid())
  tenantId    String
  examId      String
  exam        Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  name        String
  startsAt    DateTime?
  endsAt      DateTime?
  venue       String?
  capacity    Int?
  /// CIDR ranges a candidate in this sitting must start from. Empty = anywhere.
  ipAllowlist String[]        @default([])
  /// A centre-wide pause: every attempt in this sitting is frozen.
  pausedAt    DateTime?
  createdAt   DateTime        @default(now())
  candidates  ExamCandidate[]

  @@index([tenantId])
  @@index([examId])
}

model ExamCandidate {
  id                String              @id @default(cuid())
  tenantId          String
  examId            String
  exam              Exam                @relation(fields: [examId], references: [id], onDelete: Cascade)
  /// Set for a learner with an account; NULL for an external candidate.
  clientId          String?
  client            Client?             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fullName          String
  email             String?
  regNumber         String?
  photoKey          String?
  /// The "Exam ID" printed on the slip. Unique per academy.
  candidateNo       String
  /// argon2 hash of the PIN. The PIN itself is shown once, on creation/reset.
  pinHash           String?
  pinFailedAttempts Int                 @default(0)
  pinLockedUntil    DateTime?
  sittingId         String?
  sitting           ExamSitting?        @relation(fields: [sittingId], references: [id], onDelete: SetNull)
  /// Accommodation: extra time as a percentage of the duration.
  extraTimePct      Int                 @default(0)
  status            ExamCandidateStatus @default(ACTIVE)
  createdAt         DateTime            @default(now())
  attempts          ExamAttempt[]
  sessions          ExamSession[]

  @@unique([tenantId, candidateNo])
  @@unique([examId, clientId])
  @@index([tenantId])
  @@index([examId])
  @@index([clientId])
}

model ExamAttempt {
  id                String            @id @default(cuid())
  tenantId          String
  examId            String
  exam              Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  candidateId       String
  candidate         ExamCandidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  attemptNo         Int               @default(1)
  status            ExamAttemptStatus @default(IN_PROGRESS)
  /// Seed the paper was drawn and shuffled with.
  seed              Int
  /// The fixed paper (order, option permutations, sections). No answer keys.
  paperJson         Json
  startedAt         DateTime          @default(now())
  /// Server-authoritative end. Extensions and pauses move it.
  deadlineAt        DateTime
  pausedAt          DateTime?
  extraSec          Int               @default(0)
  lockedAt          DateTime?
  submittedAt       DateTime?
  submitReason      ExamSubmitReason?
  /// Binds the attempt to the device that started it.
  deviceToken       String?
  ip                String?
  userAgent         String?
  sebVerified       Boolean           @default(false)
  lastHeartbeatAt   DateTime?
  /// Some answers arrived after the deadline, inside the offline grace window.
  offlineSubmitted  Boolean           @default(false)
  violationCount    Int               @default(0)
  answeredCount     Int               @default(0)
  scorePoints       Float?
  maxPoints         Float?
  scorePercent      Float?
  sectionScoresJson Json?
  passed            Boolean?
  grade             String?
  /// PENDING = something needs a staff (or AI) mark before the score is final.
  gradingStatus     GradingStatus?
  gradedAt          DateTime?
  releasedAt        DateTime?
  createdAt         DateTime          @default(now())
  responses         ExamResponse[]
  events            ExamEvent[]

  @@unique([candidateId, attemptNo])
  @@index([tenantId])
  @@index([examId, status])
  @@index([status, deadlineAt])
}

model ExamResponse {
  id               String      @id @default(cuid())
  tenantId         String
  attemptId        String
  attempt          ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  /// The paper item this answers (the question id).
  itemKey          String
  answerJson       Json?
  flagged          Boolean     @default(false)
  timeSpentSec     Int         @default(0)
  /// Client revision counter. A sync only overwrites with a higher rev.
  rev              Int         @default(0)
  clientSavedAt    DateTime?
  updatedAt        DateTime    @updatedAt
  autoPoints       Float?
  manualPoints     Float?
  maxPoints        Float?
  /// The grader's detail (per blank / per pair / rubric criteria).
  detailJson       Json?
  feedback         String?
  aiSuggestionJson Json?
  markedById       String?
  markedAt         DateTime?

  @@unique([attemptId, itemKey])
  @@index([tenantId])
}

/// The integrity log: every focus loss, fullscreen exit, reconnect, proctor action.
model ExamEvent {
  id            String      @id @default(cuid())
  tenantId      String
  attemptId     String
  attempt       ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  type          String
  /// 0 info, 1 warning, 2 violation (counts toward the strike limit).
  severity      Int         @default(0)
  /// Client-generated id, so a resent batch is not double-counted.
  clientEventId String?
  clientAt      DateTime?
  detailJson    Json?
  actorId       String?
  createdAt     DateTime    @default(now())

  @@unique([attemptId, clientEventId])
  @@index([tenantId])
  @@index([attemptId, createdAt])
}

model ExamAnnouncement {
  id          String   @id @default(cuid())
  tenantId    String
  examId      String
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  /// NULL = everyone in the exam.
  sittingId   String?
  candidateId String?
  message     String
  createdById String?
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([examId, createdAt])
}

/// A sign-in for an exam candidate who used Exam ID + PIN. Scoped to one exam.
model ExamSession {
  id          String        @id @default(cuid())
  tenantId    String
  tokenHash   String        @unique
  candidateId String
  candidate   ExamCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  examId      String
  expiresAt   DateTime
  revokedAt   DateTime?
  ip          String?
  userAgent   String?
  createdAt   DateTime      @default(now())

  @@index([tenantId])
  @@index([candidateId])
}

/// A certificate template (design stored as contentJson for the WYSIWYG editor),
/// optionally tied to a specific course or programme it certifies completion of.
model Certificate {
  id          String             @id @default(cuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  courseId    String?
  course      Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  programmeId String?
  programme   Programme?         @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  contentJson Json               @default("{}")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  awards      CertificateAward[]

  @@index([tenantId])
}

/// An issued certificate for a client, tied to a course/programme completion.
model CertificateAward {
  id            String      @id @default(cuid())
  tenantId      String
  certificateId String
  certificate   Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  courseId      String?
  programmeId   String?
  serial        String      @unique
  issuedAt      DateTime    @default(now())

  @@unique([certificateId, clientId])
  @@index([tenantId])
  @@index([clientId])
}

/// A scheduled tenant activity (session, deadline, reminder, announcement).
/// Targets all clients, a single client, or a client group; supports simple
/// recurrence.
model Event {
  id              String          @id @default(cuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  type            EventType       @default(ANNOUNCEMENT)
  startAt         DateTime
  endAt           DateTime?
  location        String?
  url             String?
  audience        EventAudience   @default(ALL)
  clientId        String?
  client          Client?         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientGroupId   String?
  clientGroup     ClientGroup?    @relation(fields: [clientGroupId], references: [id], onDelete: Cascade)
  recurrence      EventRecurrence @default(NONE)
  recurrenceUntil DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([tenantId, startAt])
}

/// A tenant-to-client message. Materialized to MessageRecipient rows on send.
model Message {
  id            String               @id @default(cuid())
  tenantId      String
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject       String
  body          String
  category      NotificationCategory @default(MESSAGE)
  senderUserId  String?
  audience      EventAudience        @default(ALL)
  clientId      String?
  clientGroupId String?
  createdAt     DateTime             @default(now())
  recipients    MessageRecipient[]

  @@index([tenantId, createdAt])
}

/// Per-client delivery of a message, with read tracking (the client inbox).
model MessageRecipient {
  id        String    @id @default(cuid())
  tenantId  String
  messageId String
  message   Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([messageId, clientId])
  @@index([tenantId])
  @@index([clientId, readAt])
}

/// A per-recipient in-app notification with read tracking (the bell).
model Notification {
  id        String               @id @default(cuid())
  tenantId  String
  clientId  String
  client    Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category  NotificationCategory
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([tenantId])
  @@index([clientId, readAt])
}

/// Per-client, per-category channel preferences (in-app / email).
model NotificationPreference {
  id       String               @id @default(cuid())
  tenantId String
  clientId String
  client   Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category NotificationCategory
  inApp    Boolean              @default(true)
  email    Boolean              @default(true)

  @@unique([clientId, category])
  @@index([tenantId])
}

/// A folder for organizing library items (self-referencing subtree).
model LibraryFolder {
  id        String          @id @default(cuid())
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  parentId  String?
  parent    LibraryFolder?  @relation("LibraryFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  LibraryFolder[] @relation("LibraryFolderTree")
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  items     LibraryItem[]
  grants    LibraryGrant[]
  uploads   LibraryUpload[]

  @@index([tenantId])
  @@index([parentId])
}

/// A managed media file in the tenant library.
model LibraryItem {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Filename-ish label, always present. `title` is the display title.
  name        String
  key         String
  contentType String
  sizeBytes   BigInt         @default(0)
  folderId    String?
  folder      LibraryFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // --- media metadata ---
  title            String?
  description      String?
  mediaKind        MediaKind @default(OTHER)
  originalFilename String?
  checksumSha256   String?
  durationSeconds  Int?
  width            Int?
  height           Int?
  posterKey        String?
  /// Pre-computed waveform buckets for audio, so the player never has to fetch
  /// and decode the whole file just to draw a waveform.
  peaksJson        Json?

  // --- visibility / commerce ---
  /// Access is `isPublic OR entitlement OR grant`. `isFree`/`priceCents` do NOT
  /// gate a grant — they only decide whether an inaccessible item shows a
  /// purchase CTA, so assigning a paid item to a cohort still works.
  isPublic   Boolean @default(false)
  isFree     Boolean @default(true)
  priceCents Int?
  currency   String?

  tags         LibraryItemTag[]
  grants       LibraryGrant[]
  entitlements LibraryEntitlement[]
  payments     LibraryPayment[]
  progress     LibraryProgress[]
  upload       LibraryUpload?
  lessons      Lesson[]

  // `key` is unique per tenant, not globally: a global unique lets one tenant's
  // insert fail on another tenant's key and leaks key existence across tenants.
  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([folderId])
  @@index([tenantId, mediaKind, createdAt])
  @@index([tenantId, isPublic])
}

/// A live S3 multipart upload. Persisted so a refresh or a dropped connection
/// can resume rather than restart. Reserves quota on create; the reservation is
/// settled on complete and released on abort/expiry.
model LibraryUpload {
  id               String              @id @default(cuid())
  tenantId         String
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadId         String
  key              String
  contentType      String
  mediaKind        MediaKind           @default(OTHER)
  originalFilename String
  /// Client-declared total, used for the quota reservation. The authoritative
  /// size comes from HeadObject at completion — a client can under-declare.
  declaredBytes    BigInt
  uploadedBytes    BigInt              @default(0)
  partSizeBytes    Int
  totalParts       Int
  status           UploadSessionStatus @default(PENDING)

  // Metadata staged while the bytes are still uploading.
  title       String?
  description String?
  folderId    String?
  folder      LibraryFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdById String?

  itemId    String?      @unique
  item      LibraryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  expiresAt DateTime
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  parts LibraryUploadPart[]

  @@unique([tenantId, key])
  @@index([tenantId, status])
  @@index([status, expiresAt])
}

model LibraryUploadPart {
  id         String        @id @default(cuid())
  tenantId   String
  uploadId   String
  upload     LibraryUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  partNumber Int
  etag       String
  sizeBytes  Int
  createdAt  DateTime      @default(now())

  @@unique([uploadId, partNumber])
  @@index([tenantId])
}

/// One grant: a target (a single item XOR a whole folder subtree) issued to one
/// subject (everyone / a learner / a client group / a course / a programme).
///
/// `targetKey` and `subjectKey` are denormalized dedupe keys ("I:<id>"/"F:<id>",
/// "ALL"/"CLIENT:<id>"/...) because Postgres treats NULLs as distinct, so a
/// composite unique over the nullable FKs would not actually dedupe.
model LibraryGrant {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  itemId    String?
  item      LibraryItem?   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  folderId  String?
  folder    LibraryFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  targetKey String

  subjectType   GrantSubjectType
  clientId      String?
  client        Client?          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientGroupId String?
  clientGroup   ClientGroup?     @relation(fields: [clientGroupId], references: [id], onDelete: Cascade)
  courseId      String?
  course        Course?          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  programmeId   String?
  programme     Programme?       @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  subjectKey    String

  canDownload Boolean   @default(true)
  startsAt    DateTime?
  expiresAt   DateTime?
  grantedById String?
  createdAt   DateTime  @default(now())

  @@unique([tenantId, targetKey, subjectKey])
  @@index([tenantId, itemId])
  @@index([tenantId, folderId])
  @@index([tenantId, subjectType, clientId])
  @@index([tenantId, subjectType, clientGroupId])
  @@index([tenantId, subjectType, courseId])
  @@index([tenantId, subjectType, programmeId])
}

/// Permanent access for one learner to one item, from a purchase or a manual
/// staff grant.
model LibraryEntitlement {
  id        String            @id @default(cuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itemId    String
  item      LibraryItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  source    EntitlementSource @default(PURCHASE)
  paymentId String?           @unique
  payment   LibraryPayment?   @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  expiresAt DateTime?
  createdAt DateTime          @default(now())

  @@unique([itemId, clientId])
  @@index([tenantId])
  @@index([clientId])
}

/// Mirrors CoursePayment / ProgrammePayment.
model LibraryPayment {
  id                String          @id @default(cuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itemId            String
  item              LibraryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  clientId          String
  client            Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  provider          PaymentProvider
  amountCents       Int
  currency          String
  status            PaymentStatus   @default(PENDING)
  externalRef       String          @unique
  platformFeeCents  Int?
  tenantPayoutCents Int?
  providerData      Json?
  createdAt         DateTime        @default(now())
  completedAt       DateTime?

  entitlement LibraryEntitlement?

  @@index([tenantId, createdAt])
  @@index([itemId])
  @@index([clientId])
}

/// Resume position per learner per item. The LessonProgress analogue, but not
/// tied to an Enrollment — library items exist outside courses.
model LibraryProgress {
  id              String      @id @default(cuid())
  tenantId        String
  itemId          String
  item            LibraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  positionSeconds Int         @default(0)
  completed       Boolean     @default(false)
  lastViewedAt    DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([itemId, clientId])
  @@index([tenantId, clientId, lastViewedAt])
}

model LibraryTag {
  id       String           @id @default(cuid())
  tenantId String
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  links    LibraryItemTag[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model LibraryItemTag {
  id       String      @id @default(cuid())
  tenantId String
  itemId   String
  item     LibraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tagId    String
  tag      LibraryTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([itemId, tagId])
  @@index([tenantId])
}

model PlatformConfig {
  key       String   @id
  valueJson Json
  updatedAt DateTime @updatedAt
}

model PlatformUser {
  id                  String     @id @default(cuid())
  email               String     @unique
  passwordHash        String
  mustChangePassword  Boolean    @default(true)
  status              UserStatus @default(ACTIVE)
  firstName           String?
  lastName            String?
  otherName           String?
  phone               String?
  isSuperAdmin        Boolean    @default(false)
  permissions         String[]   @default([])
  createdAt           DateTime   @default(now())
  lastLoginAt         DateTime?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
}

model TenantUser {
  id                  String                      @id @default(cuid())
  tenantId            String
  tenant              Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email               String
  passwordHash        String
  mustChangePassword  Boolean                     @default(true)
  status              UserStatus                  @default(ACTIVE)
  firstName           String?
  lastName            String?
  otherName           String?
  phone               String?
  isOwner             Boolean                     @default(false)
  permissions         String[]                    @default([])
  createdAt           DateTime                    @default(now())
  lastLoginAt         DateTime?
  failedLoginAttempts Int                         @default(0)
  lockedUntil         DateTime?
  groupMemberships    TenantUserGroupMembership[]
  referralCode        ReferralCode?

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Client {
  id                   String                   @id @default(cuid())
  tenantId             String
  tenant               Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email                String
  passwordHash         String?
  mustChangePassword   Boolean                  @default(false)
  status               ClientStatus             @default(ACTIVE)
  firstName            String?
  lastName             String?
  otherName            String?
  phone                String?
  profileJson          Json                     @default("{}")
  /// The staff referral code this learner signed up through, if any.
  referralCodeId       String?
  referralCode         ReferralCode?            @relation(fields: [referralCodeId], references: [id], onDelete: SetNull)
  referredAt           DateTime?
  createdAt            DateTime                 @default(now())
  lastLoginAt          DateTime?
  failedLoginAttempts  Int                      @default(0)
  lockedUntil          DateTime?
  referralEvents       ReferralEvent[]
  enrollments          Enrollment[]
  programmeEnrollments ProgrammeEnrollment[]
  coursePayments       CoursePayment[]
  programmePayments    ProgrammePayment[]
  libraryGrants        LibraryGrant[]
  libraryEntitlements  LibraryEntitlement[]
  libraryPayments      LibraryPayment[]
  libraryProgress      LibraryProgress[]
  submissions          Submission[]
  grades               Grade[]
  groupMemberships     ClientGroupMembership[]
  fees                 Fee[]
  feePayments          FeePayment[]
  quizAttempts         QuizAttempt[]
  examCandidates       ExamCandidate[]
  certificateAwards    CertificateAward[]
  events               Event[]
  messageReceipts      MessageRecipient[]
  notifications        Notification[]
  notificationPrefs    NotificationPreference[]
  loginLinks           LoginLinkToken[]
  /// The id an outside system (school portal, HR / CRM) knows this learner by.
  /// Set through the Developer API; unique per academy so upserts are idempotent.
  externalId           String?

  @@unique([tenantId, email])
  @@unique([tenantId, externalId])
  @@index([tenantId])
  @@index([referralCodeId])
}

/// A cohort/group of tenant staff users (many-to-many via TenantUserGroupMembership).
model UserGroup {
  id          String                      @id @default(cuid())
  tenantId    String
  tenant      Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  memberships TenantUserGroupMembership[]
  bankAccess  QuestionBankAccess[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// Join row: a TenantUser belongs to a UserGroup. Tenant-scoped for isolation.
model TenantUserGroupMembership {
  id        String     @id @default(cuid())
  tenantId  String
  groupId   String
  group     UserGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      TenantUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([groupId, userId])
  @@index([tenantId])
  @@index([userId])
}

/// A cohort/group of clients (learners), many-to-many via ClientGroupMembership.
model ClientGroup {
  id            String                  @id @default(cuid())
  tenantId      String
  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  memberships   ClientGroupMembership[]
  fees          Fee[]
  events        Event[]
  libraryGrants LibraryGrant[]
  /// The id an outside system knows this group (class, cohort) by.
  externalId    String?

  @@unique([tenantId, name])
  @@unique([tenantId, externalId])
  @@index([tenantId])
}

/// Join row: a Client belongs to a ClientGroup. Tenant-scoped for isolation.
model ClientGroupMembership {
  id        String      @id @default(cuid())
  tenantId  String
  groupId   String
  group     ClientGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([groupId, clientId])
  @@index([tenantId])
  @@index([clientId])
}

model PasswordResetToken {
  id         String          @id @default(cuid())
  tokenHash  String          @unique
  userType   SessionUserType
  userId     String
  tenantId   String?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime        @default(now())

  @@index([expiresAt])
}

/// In-flight client self-signup: created after form+password, deleted after OTP verifies.
model PendingClientRegistration {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  firstName    String?
  lastName     String?
  otherName    String?
  phone        String?
  profileJson  Json     @default("{}")
  /// Referral code captured when registration started (from the `?ref=` cookie
  /// or the form). Resolved against ReferralCode when the account is created.
  referralCode String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@unique([tenantId, email])
  @@index([tenantId])
}

model RoleTemplate {
  id          String    @id @default(cuid())
  scope       RoleScope
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  permissions String[]
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@unique([scope, tenantId, name])
  @@index([scope, tenantId])
}

model Permission {
  key         String @id
  module      String
  description String
}

model ActivityLog {
  id         String    @id @default(cuid())
  tenantId   String?
  tenant     Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actorType  ActorType
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  beforeJson Json?
  afterJson  Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@index([actorId])
  @@index([action])
}

model OtpRequest {
  id         String     @id @default(cuid())
  identifier String
  codeHash   String
  purpose    OtpPurpose
  tenantId   String?
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([identifier, createdAt])
  @@index([tenantId])
}

model Session {
  id        String          @id
  userId    String
  userType  SessionUserType
  tenantId  String?
  scope     SessionScope    @default(FULL)
  issuedAt  DateTime        @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
}

model Template {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type        String
  name        String
  contentJson Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([tenantId, type])
}

/// Public CMS page for a tenant landing site (home + extra pages).
/// A staff member's referral code. Learners who arrive through it are
/// attributed to them; there is no reward logic, only tracking.
model ReferralCode {
  id           String          @id @default(cuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// What appears in `?ref=`. Unique within the tenant; stored upper-case.
  code         String
  tenantUserId String          @unique
  tenantUser   TenantUser      @relation(fields: [tenantUserId], references: [id], onDelete: Cascade)
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  events       ReferralEvent[]
  clients      Client[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

/// One attributed outcome: a sign-up, an enrolment or a purchase.
model ReferralEvent {
  id             String            @id @default(cuid())
  tenantId       String
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  referralCodeId String
  referralCode   ReferralCode      @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  type           ReferralEventType
  clientId       String
  client         Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  courseId       String?
  programmeId    String?
  libraryItemId  String?
  amountCents    Int?
  currency       String?
  /// What makes this event unique, so a replayed webhook or a double submit
  /// records it once: the client id for SIGNUP, the enrolment id for
  /// ENROLLMENT, the payment reference for PURCHASE.
  reference      String
  createdAt      DateTime          @default(now())

  @@unique([type, reference])
  @@index([tenantId, createdAt])
  @@index([referralCodeId, type])
  @@index([clientId])
}

/// The site's shared chrome. No row means the built-in header and footer.
model SiteLayout {
  tenantId    String   @id
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Empty string = built-in default. Same template + sanitizer pipeline as a page.
  headerHtml  String   @default("")
  footerHtml  String   @default("")
  /// CSS applied to every page of the site, scoped like page CSS.
  sharedCss   String   @default("")
  updatedAt   DateTime @updatedAt
  updatedById String?
}

model SitePage {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Empty string = home page.
  slug           String         @default("")
  title          String
  /// PAGE for ordinary pages. Any other kind replaces a built-in screen and
  /// uses a reserved slug, so `@@unique([tenantId, slug])` allows one per kind.
  kind           SitePageKind   @default(PAGE)
  status         SitePageStatus @default(DRAFT)
  isHome         Boolean        @default(false)
  showInNav      Boolean        @default(true)
  navOrder       Int            @default(0)
  seoTitle       String?
  seoDescription String?
  ogImageKey     String?
  /// The page itself: one HTML document authored in the site builder. May
  /// contain {{ variables }} resolved at render time. Sanitized on write and
  /// again on read - never trust the stored value.
  htmlSource     String         @default("")
  /// When false the page renders standalone - no site header/nav/footer.
  includeShell   Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, isHome])
  @@index([tenantId, kind, status])
}

model PasswordHistory {
  id        String          @id @default(cuid())
  userType  SessionUserType
  userId    String
  hash      String
  createdAt DateTime        @default(now())

  @@index([userType, userId, createdAt])
}

model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String
  scope      String
  success    Boolean
  ip         String?
  createdAt  DateTime @default(now())

  @@index([identifier, scope, createdAt])
}

model ReservedSlug {
  slug      String   @id
  reason    String
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// Developer API & webhooks. See lib/api/v1/ and lib/integrations/.
// ─────────────────────────────────────────────────────────────────────────────

enum ApiUsagePeriod {
  MINUTE
  DAY
}

enum WebhookEndpointStatus {
  ACTIVE
  DISABLED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
  DEAD
}

/// A tenant's Developer API key. The full key ("plms_live_<prefix>_<secret>")
/// is shown once; only its sha256 is kept. Looked up by hash through rawPrisma
/// before any tenant context exists; every other access is tenant-bound.
model ApiKey {
  id               String            @id @default(cuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  /// "plms_live_ab12cd34" — what lists show, and how a leaked key is identified.
  prefix           String            @unique
  keyHash          String            @unique
  scopes           String[]          @default([])
  /// CIDR ranges / addresses the key may be used from. Empty = anywhere.
  ipAllowlist      String[]          @default([])
  rateLimitPerMin  Int               @default(120)
  expiresAt        DateTime?
  lastUsedAt       DateTime?
  lastUsedIp       String?
  revokedAt        DateTime?
  /// Set on the key that replaced another; the old key expires 24h after.
  rotatedFromId    String?
  createdById      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  usage            ApiUsage[]
  idempotency      ApiIdempotency[]
  requestLogs      ApiRequestLog[]
  webhookEndpoints WebhookEndpoint[]

  @@index([tenantId])
}

/// Request counters per key: MINUTE buckets back the rate limit (Upstash fails
/// open), DAY buckets feed the usage charts.
model ApiUsage {
  id         String         @id @default(cuid())
  tenantId   String
  apiKeyId   String
  apiKey     ApiKey         @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  period     ApiUsagePeriod
  bucket     DateTime
  count      Int            @default(0)
  errorCount Int            @default(0)

  @@unique([apiKeyId, period, bucket])
  @@index([tenantId, period, bucket])
}

/// Idempotency-Key replay store: the first response to a key is kept 24 hours.
model ApiIdempotency {
  id           String   @id @default(cuid())
  tenantId     String
  apiKeyId     String
  apiKey       ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  key          String
  method       String
  path         String
  requestHash  String
  /// NULL while the first request is still running.
  status       Int?
  responseBody String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@unique([apiKeyId, key])
  @@index([tenantId])
  @@index([expiresAt])
}

/// One authenticated /api/v1 request. Pruned after 30 days.
model ApiRequestLog {
  id         String   @id @default(cuid())
  tenantId   String
  apiKeyId   String
  apiKey     ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  requestId  String
  method     String
  path       String
  query      String?
  status     Int
  durationMs Int
  errorCode  String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([apiKeyId, createdAt])
}

model WebhookEndpoint {
  id                      String                @id @default(cuid())
  tenantId                String
  tenant                  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url                     String
  description             String?
  /// Event types, or ["*"] for every event.
  events                  String[]              @default([])
  /// Signing secret, encrypted with lib/crypto/secret-box.
  secretEnc               String
  /// The secret being rotated out; deliveries are signed with both until it expires.
  previousSecretEnc       String?
  previousSecretExpiresAt DateTime?
  status                  WebhookEndpointStatus @default(ACTIVE)
  /// "portal" (made in the developer portal) or "rest_hook" (POST /v1/webhooks).
  source                  String                @default("portal")
  apiKeyId                String?
  apiKey                  ApiKey?               @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  consecutiveFailures     Int                   @default(0)
  /// First failure of the current unbroken run of failures.
  failingSince            DateTime?
  lastSuccessAt           DateTime?
  lastFailureAt           DateTime?
  disabledAt              DateTime?
  disabledReason          String?
  createdById             String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  deliveries              WebhookDelivery[]

  @@index([tenantId])
}

/// The outbox: one row per event that at least one endpoint subscribed to.
model WebhookEvent {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type        String
  payloadJson Json
  createdAt   DateTime          @default(now())
  deliveries  WebhookDelivery[]

  @@index([tenantId, createdAt])
}

model WebhookDelivery {
  id                 String                @id @default(cuid())
  tenantId           String
  eventId            String
  event              WebhookEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpointId         String
  endpoint           WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  status             WebhookDeliveryStatus @default(PENDING)
  /// Attempts made so far.
  attempt            Int                   @default(0)
  nextAttemptAt      DateTime?             @default(now())
  /// Claim lease, so the inline first attempt and the sweeper never double-send.
  lockedUntil        DateTime?
  lastAttemptAt      DateTime?
  responseStatus     Int?
  /// The first 2 KB of the response body.
  responseBody       String?
  errorMessage       String?
  durationMs         Int?
  requestHeadersJson Json?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
  @@index([tenantId, createdAt])
  @@index([eventId])
}

/// One-time magic sign-in link for a learner, minted by
/// POST /v1/learners/{id}/login-link. Looked up by hash through rawPrisma.
model LoginLinkToken {
  id           String    @id @default(cuid())
  tenantId     String
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  redirectPath String?
  apiKeyId     String?
  expiresAt    DateTime
  consumedAt   DateTime?
  consumedIp   String?
  createdAt    DateTime  @default(now())

  @@index([tenantId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Integrations hub (/admin/integrations). See lib/integrations/registry.ts.
// ─────────────────────────────────────────────────────────────────────────────

enum IntegrationStatus {
  CONNECTED
  /// Kept but switched off by the academy.
  DISABLED
  /// The last call to the provider failed; see lastError.
  ERROR
}

/// One connection to an outside service: an alert channel, Zoom, Google
/// Calendar, or a single sign-on provider. Settings that are not secret live
/// in configJson; credentials are sealed with lib/crypto/secret-box in
/// secretsEnc (a JSON object, encrypted as one value).
model TenantIntegration {
  id            String             @id @default(cuid())
  tenantId      String
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// A provider id from lib/integrations/registry.ts ("slack", "zoom", "oidc_google"…).
  provider      String
  /// The academy's label. Providers that allow several connections (alert
  /// channels, SSO) tell them apart by it; single ones use "".
  name          String             @default("")
  status        IntegrationStatus  @default(CONNECTED)
  configJson    Json               @default("{}")
  secretsEnc    String?
  connectedById String?
  lastSyncAt    DateTime?
  lastError     String?
  lastErrorAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  ssoIdentities SsoIdentity[]
  meetings      IntegrationMeeting[]

  @@unique([tenantId, provider, name])
  @@index([tenantId, provider])
}

/// Which outside account a learner or staff member signs in with, per SSO
/// connection. Exactly one of clientId / userId is set, matching userType.
model SsoIdentity {
  id            String            @id @default(cuid())
  tenantId      String
  integrationId String
  integration   TenantIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  /// "CLIENT" (learner) or "TENANT" (staff).
  userType      String
  /// The identity provider's stable subject ("sub").
  subject       String
  email         String
  clientId      String?
  userId        String?
  lastLoginAt   DateTime?
  createdAt     DateTime          @default(now())

  @@unique([integrationId, userType, subject])
  @@index([tenantId])
  @@index([clientId])
  @@index([userId])
}

/// A meeting created at Zoom or Google for a LIVE_SESSION event, so editing
/// the event updates the same meeting instead of making another.
model IntegrationMeeting {
  id            String            @id @default(cuid())
  tenantId      String
  integrationId String
  integration   TenantIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  eventId       String
  /// "zoom" or "google_calendar".
  provider      String
  /// Zoom meeting id, or Google Calendar event id.
  externalId    String
  joinUrl       String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([eventId, provider])
  @@index([tenantId])
}

/// A private calendar subscription (ICS) URL for one learner or staff member.
/// Only the sha256 of the token is kept; the URL is shown once. Looked up by
/// hash through rawPrisma, before any tenant context exists.
model CalendarFeedToken {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// "CLIENT" (learner) or "TENANT" (staff).
  ownerType  String
  ownerId    String
  tokenHash  String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId, ownerType, ownerId])
}
