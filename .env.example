# Copy to `.env` and adjust values for your environment.
# Required variables are validated at startup via `lib/env.ts`.

# --- Core ---
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/multi_tenant
APP_DOMAIN=localhost:3000
PLATFORM_SUBDOMAIN=platform
PRODUCT_NAME=Prisma LMS
TENANT_TRIAL_DAYS=90
# Dev URLs:
#   Marketing:  http://localhost:3000
#   Platform:   http://platform.localhost:3000
#   Tenant:     http://{slug}.localhost:3000
# Platform admin login requires `npm run db:seed` (not just `db:seed:demo`).

# --- Auth & security ---
# SESSION_SECRET: min 16 characters
SESSION_SECRET=change-me-to-a-long-random-string
# OTP_PEPPER: min 8 characters (peppers email OTP hashes)
OTP_PEPPER=change-me-otp-pepper

# --- Platform seed user (used by `npm run db:seed`) ---
PLATFORM_ADMIN_EMAIL=admin@example.com
# PLATFORM_ADMIN_PASSWORD: min 12 characters
PLATFORM_ADMIN_PASSWORD=change-me-12ch

# --- SMTP (transactional email) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=Prisma LMS
# Set to "true" for TLS (e.g. port 465)
SMTP_SECURE=false

# --- AI (course builder, essay grading, site and certificate design) — optional ---
# Without a key every AI feature reports "AI is not set up" instead of failing.
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Model in Mastra's "provider/model" form. The key that is required follows the
# provider (anthropic/... needs ANTHROPIC_API_KEY, openrouter/... needs
# OPENROUTER_API_KEY). Defaults to anthropic/claude-sonnet-5.
# AI_MODEL=anthropic/claude-sonnet-5

# --- Billing — optional ---
# Platform keys only; tenants never provide payment API keys.
# Default platform commission on course/programme sales (overridden per-tenant
# by TenantSubaccount.platformCommissionPct).
# PLATFORM_COMMISSION_PCT=10
#
# Monnify is the active gateway whenever all three values below are set.
# Use the sandbox values from the Monnify dashboard for local testing.
# MONNIFY_API_KEY=MK_TEST_xxxxxxxx
# MONNIFY_SECRET_KEY=
# MONNIFY_CONTRACT_CODE=
# Sandbox: https://sandbox.monnify.com   Live: https://api.monnify.com
# MONNIFY_BASE_URL=https://sandbox.monnify.com
# MONNIFY_ENABLED=true            # "false" switches Monnify off without removing its keys
# MONNIFY_ENV=sandbox             # informational; MONNIFY_BASE_URL is what is called
# MONNIFY_WALLET_ACCOUNT_NUMBER=  # merchant wallet, for disbursements
# MONNIFY_CALLBACK_IPS=35.242.133.146   # optional allowlist for webhook source addresses
#
# Which gateway takes new checkouts: MONNIFY, PAYSTACK or FLUTTERWAVE.
# Unset = the first configured one, in that order. Payments already started on
# another gateway are still confirmed by that gateway.
# PAYMENT_PROVIDER=MONNIFY
# Point the Monnify webhook (Settings > API Keys & Webhooks) at:
#   {APP_DOMAIN}/api/webhooks/monnify
# Paying academies their share needs sub-accounts, which Monnify must switch on
# for your merchant account (sandbox and live) on request.
#
# Paystack and Flutterwave are legacy: still honoured for payments started on
# them, and used only when Monnify is not configured.
# Paystack (use test keys, sk_test_/pk_test_, for local end-to-end testing).
# Both keys are required for Paystack checkout + webhooks to be enabled.
# PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx
# PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
# Point your Paystack test webhook at: {APP_DOMAIN}/api/webhooks/paystack
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_PUBLIC_KEY=
# FLUTTERWAVE_SECRET_HASH=

# --- Rate limiting (Upstash Redis) — optional ---
# When unset, rate limiting is skipped (fails open).
# RATE_LIMIT_ENABLED=false
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Object storage (S3 / MinIO) — optional ---
# Branding uploads are disabled until bucket + credentials are set.
# S3_REGION=us-east-1
# S3_BUCKET=tenant-assets
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_BASE_URL=http://localhost:9000/tenant-assets
# Set S3_PUBLIC_BASE_URL when the bucket is publicly readable; otherwise presigned URLs are used.
# S3_FORCE_PATH_STYLE=true

# --- i18n ---
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,es

# Cloudflare (optional; used for DNS and wildcard certificates, not read by the app)
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Dokploy (used only by `npm run deploy`, not read by the app)
DOKPLOY_URL=
DOKPLOY_API_KEY=
DOKPLOY_APP_ID=
